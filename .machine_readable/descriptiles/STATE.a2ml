#
# STATE.a2ml — Project state checkpoint for Marid.
# Monorepo structure maintained; 13 packages + 4 browser packages + reference app active.

[metadata]
project = "marid"
version = "0.1.0"
last-updated = "2026-09-19"
# status: active | paused | archived | planned
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it — never
# hand-edit both into agreement (standards#726).
status = "active"

[project-context]
name = "marid"
purpose = "Julia-first framework for web applications, APIs, and reactive scientific dashboards, with interoperable protocols and frontend independence."
readiness = "unverified; see docs/audits/evidence-ledger.adoc"

[position]
phase = "incubating"     # derived from authoritative CLADE [status].phase
maturity = "experimental"   # experimental | alpha | beta | production | lts

[route-to-mvp]
# Gates from PROJECT_BRIEF.md §9. Completion is honest.
milestones = [
  { name = "Gate 0: feasibility and licensing audit", acceptance = "not established" },
  { name = "Gate 1: interoperability spikes", acceptance = "not established" },
  { name = "Gate 2: foundation (skeletons, contracts, CI)", acceptance = "not established" },
  { name = "Gate 3: independent packages", acceptance = "not established" },
  { name = "Gate 4: assembly and browser integrations", acceptance = "not established" },
  { name = "Gate 5: release review", acceptance = "not established" },
]

[blockers-and-issues]
# Source and unit tests exist; independent interoperability remains gated.
issues = ["real persistence absent", "browser/protocol acceptance incomplete", "hosted CI/settings require owner follow-up", "gateway full suite: 15 baseline-reproduced failures", "gateway dependency advisories and container/identity/rollback acceptance unresolved"]

[critical-next-actions]
actions = [
  "Monorepo structure actively maintained across all 13 packages and 4 browser packages.",
  "Await explicit user instruction before splitting away into dedicated repositories.",
  "Review the completed local evidence/HTTP/strict-gateway checkpoints and resolve remaining security/CI/container gates before persistence or browser/protocol acceptance.",
]

[ordered-local-checkpoints]
status = "local only; uncommitted and unpushed"
evidence = "docs/audits/evidence-ledger.adoc"
julia-package-assertions = 385
real-http-json-assertions = 38
gateway-http-tests = 7
gateway-http-assertions = 47
acceptance = "bounded unary slice only; broader release gates remain unresolved"

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "not-run"
# No maintenance run counts are asserted; see the evidence ledger for findings.

[ecosystem]
part-of = ["hyperpolymath estate"]
depends-on = ["Julia General registry (package dependencies)", "ArangoDB test instance (3.12 Community Edition)", "Bun 1.4 runtime"]
