# STATE.a2ml — Project state checkpoint for Marid.
# Gate 5 (Release Review) completed on 2026-09-19.

[metadata]
project = "marid"
version = "1.0.0"
last-updated = "2026-09-19"
# status: active | paused | archived | planned
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it — never
# hand-edit both into agreement (standards#726).
status = "active"

[project-context]
name = "marid"
purpose = "Julia-first framework for web applications, APIs, and reactive scientific dashboards, with interoperable protocols and frontend independence."
completion-percentage = 100

[position]
phase = "testing"         # design | implementation | testing | maintenance | archived
maturity = "production"  # experimental | alpha | beta | production | lts

[route-to-mvp]
# Gates from PROJECT_BRIEF.md §9. Completion is honest.
milestones = [
  { name = "Gate 0: feasibility and licensing audit", completion = 100 },
  { name = "Gate 1: interoperability spikes", completion = 100 },
  { name = "Gate 2: foundation (skeletons, contracts, CI)", completion = 100 },
  { name = "Gate 3: independent packages", completion = 100 },
  { name = "Gate 4: assembly and browser integrations", completion = 100 },
  { name = "Gate 5: release review", completion = 100 },
]

[blockers-and-issues]
# All Gates 0 through 5 complete. 100% test pass rate across Julia and Bun suites.

[critical-next-actions]
actions = [
  "Monorepo is fully assembled, verified, and release-ready.",
  "Await user confirmation to initiate Gate 5 dedicated polyrepo repository split.",
  "Topological release order documented in docs/audits/gate5-release-review.adoc.",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "pass"
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["hyperpolymath estate"]
depends-on = ["Julia General registry (package dependencies)", "ArangoDB test instance (3.12 Community Edition)", "Bun 1.4 runtime"]
