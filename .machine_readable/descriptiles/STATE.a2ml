#
# STATE.a2ml — Project state checkpoint for Marid.
# Rewritten at mint (2026-09-18): the template's milestones described the
# TEMPLATE's evolution, not this project's. Current plan: PROJECT_BRIEF.md §9.

[metadata]
project = "marid"
version = "0.2.0"
last-updated = "2026-09-18"
# status: active | paused | archived | planned
#   planned — the repo is RESERVED but has not started (minted as a placeholder;
#             equivalent to CLADE [status] phase = "reserved"). It is NOT
#             "paused": paused reads as "was active, stopped".
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it — never
# hand-edit both into agreement (standards#726).
status = "active"

[project-context]
name = "marid"
purpose = "Julia-first framework for web applications, APIs, and reactive scientific dashboards, with interoperable protocols and frontend independence."
completion-percentage = 5

[position]
phase = "design"         # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
# Gates from PROJECT_BRIEF.md §9. Completion is honest: nothing is implemented.
milestones = [
  { name = "Gate 0: feasibility and licensing audit", completion = 0 },
  { name = "Gate 1: interoperability spikes", completion = 0 },
  { name = "Gate 2: foundation (skeletons, contracts, CI)", completion = 0 },
  { name = "Gate 3: independent packages", completion = 0 },
  { name = "Gate 4: assembly and browser integrations", completion = 0 },
  { name = "Gate 5: release review", completion = 0 },
]

[blockers-and-issues]
# No active blockers — Gate 0 (feasibility audit) is the current work, not yet started.

[critical-next-actions]
actions = [
  "Run the Gate 0 kickoff (docs/agent-launch.adoc §1): feasibility, dependency, and licensing discovery only.",
  "Produce docs/audits/feasibility.adoc + licensing.adoc with sources and dates checked.",
  "Produce initial docs/marid-architecture.adoc, marid-compatibility.adoc, marid-roadmap.adoc.",
  "Break implementation into small, reviewable issues with acceptance tests.",
  "Stop for approval before any new runtime, substantial generator, or non-Julia bridge.",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["hyperpolymath estate"]
depends-on = ["Julia General registry (package dependencies, from Gate 2)", "ArangoDB test instance (release TBD at Gate 0)"]
