# SPDX-License-Identifier: MPL-2.0
# ECOSYSTEM.a2ml — Ecosystem position for Marid.
# Rewritten at mint (2026-09-18): the template's entries described the
# TEMPLATE's own position, not this project's.

[metadata]
project = "marid"
ecosystem = "hyperpolymath"

[position]
type = "monorepo"
purpose = "Julia-first framework for web applications, APIs, and reactive scientific dashboards: thirteen charter packages (launch set, core, storage, later) and a framework-independent AffineScript browser client under Bun, proved by one reference application."
# IS-NOT — anti-identity (the boundary-erosion guard; each line is a real past confusion)
what-this-is-not = [
  "a database engine (ArangoDB is the database; ArangoDB.jl is a client)",
  "a replacement universal IDL (MaridIR emits native artifacts but is never a wire format; contracts/ records them)",
  "a frontend framework (React/Vue are supported through standard APIs, never replaced)",
  "a Genie clone built in one task (package-first program with gated acceptance tests)",
]

[pipeline]
position = "application-framework"
chain = "standards → rsr-template-repo → marid → (Marid.jl applications)"
notes = "marid turns the Marid brief (PROJECT_BRIEF.md) and framework charter (docs/MARID-FRAMEWORK.adoc) into thirteen charter packages plus an AffineScript browser client under Bun. Minted from rsr-template-repo via just repo-init (julia-library archetype); Marid program paths recorded in VARIANT.a2ml [paths.added]."
coordination = "standards"

[related-projects]
projects = [
  { name = "standards", relationship = "standard-source", notes = "Defines the RSR standard, contractile canon, and policies this repo's scaffolding operationalises." },
  { name = "rsr-template-repo", relationship = "minted-from", notes = "Parent template (parent-pin in VARIANT.a2ml). Drift gate: scripts/check-variant-drift.sh." },
  { name = "gv-clade-index", relationship = "registry", notes = "Clade registry; registration is the owner's act (CLADE.a2ml), not yet done." },
]
