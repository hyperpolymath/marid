# SPDX-License-Identifier: MPL-2.0
# Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
#
# rsr-profile.a2ml — this repo's declared RSR v2.0 capabilities.
#
# Authored in the A2ML record dialect (hyperpolymath/a2ml,
# RECORD-DIALECT-SPEC.adoc -- note: NOT hyperpolymath/standards; the a2ml/
# subtree was evicted from standards by 24a12d6f on 2026-08-28).
#
# GRAMMAR: still superseded -- the normative grammar for this family is
# 1-formats/deed/spec/DEED-GRAMMAR-SPEC.adoc in hyperpolymath/standards and the extension
# is becoming .deed. This file keeps its record surface until the estate-wide
# conversion lands (estate task #64) -- do not hand-convert it.
#
# BINDING: NOT superseded. The [canon] block at the end of this file is
# normative and hash-pinned; it is what makes this template accountable to the
# canon rather than merely describing it.
#
# It declares which capabilities this repo has,
# per 0-canon/TEMPLATE-APPLICABILITY-POLICY.adoc; the RSR v2.0 conformance oracle
# (hypatia Hypatia.Rules.RsrConformance) uses `capabilities` to compute the
# APPLICABLE criteria set — a gated criterion is scored only when its gating
# capability appears below; everything else is `na` and excluded from the
# denominator.
#
# rsr-template-repo is deliberately MAXIMAL: it ships scaffolding for FFI/ABI
# seams, in-tree formal proofs, a container, a reproducible build, benchmarks,
# a docs site, and the full governance trio — so a repo scaffolded FROM it can
# adopt any of them. Its declared set is therefore near-total, which is exactly
# what makes it the dogfood target (the gate requires Gold on the applicable
# set). Every capability below is grounded in a file/dir that actually exists
# in this tree; capabilities it does NOT have (rust, affinescript, mobile,
# web-ui, api-service, published-package) are omitted so the oracle does not
# score this repo against modules it does not carry.

[rsr-profile]
version = "1.0.0"
spec = "rsr-criteria-v2"
declares-against = "2.0.0-draft"
# Role in the estate pipeline: standards (canon) -> THIS (spine) -> scaffoldia
# (composer) -> minted repos. A spine may carry capability-gated modules it
# does not declare, for the repos minted from it; see [carrier] in the canon
# gates table. A minted repo doing the same is still drift.
role = "spine"
# Effective capability set (direct declaration; no preset shorthand used).
capabilities = [
  "zig",                # src/interface/ffi/build.zig + Zig FFI layer
  "idris2",             # abi.ipkg + src/interface/Abi/ (dependent-typed ABI)
  "bash",               # scripts/*.sh automation
  "cli",                # src/ command-line entry scaffolding
  "library",            # consumed/published as a library surface
  "ffi",                # C-ABI FFI seam (Zig), src/interface/ffi/
  "abi",                # formally specified ABI: abi.ipkg + src/interface/Abi/ proofs
  "formal-proofs",      # verification/proofs/ (in-tree mechanised proofs)
  "docs-site",          # .github/workflows/pages.yml (casket/Pages)
  "container",          # build/container/ + .devcontainer/Containerfile
  "reproducible-build", # guix.scm
  "benchmarks",         # benches/
  "governance-tier",    # full AUDIT/AFFIRMATION/GOVERNANCE/MAINTAINERS trio
]

[canon]
# ---------------------------------------------------------------------------
# THE BINDING. This is the half that turns "the template reflects the
# standards" from a claim into a check.
#
# Before this block, this repo declared its conformance with two free-text
# strings in [rsr-profile] above:
#
#     spec             = "rsr-criteria-v2"
#     declares-against = "2.0.0-draft"
#
# Nothing failed when the canon's criteria changed, when its gate table
# changed, or when its applicability policy changed. A grep for any version
# identifier across BOTH repos returned exactly one hit — that string.
#
# These values are hashes, and ALL THREE are checked from both directions.
#
#   forward   Gate A (scripts/check-canon-lockstep.sh in hyperpolymath/standards,
#             run by .github/workflows/canon-spine-lockstep.yml) asserts this
#             repo has adopted the canon: `criteria_sha256` must equal
#             canon.lock [canon.artifacts].criteria.sha256.
#
#   reverse   this repo's own `Canon lockstep` job (.github/workflows/
#             dogfood-gate.yml) compares version, criteria_sha256 AND
#             gates_sha256 against canon.lock. A mismatch is a FAILURE.
#
# The reverse direction used to check `criteria_sha256` alone, while this
# comment claimed "these values" — plural — were asserted. The claim was wider
# than the check, so `version` and `gates_sha256` could sit at stale values
# silently. They did: canon 2.0.1 changed gates_sha256, and this file went on
# asserting 2.0.0 and the superseded hash. A pin nothing verifies is not a
# binding. Recorded as F8 in hyperpolymath/standards docs/AUDIT.adoc.
#
# The reverse direction is .machine_readable/PROVENANCE.a2ml, written at mint by
# build/just/repo-init.just: every minted repo records the canon it was cut
# from, so "which repos are on canon 1.x?" becomes a grep instead of a campaign.
# ---------------------------------------------------------------------------
version         = "2.0.4"
# MUST equal canon.lock [canon.artifacts].criteria.sha256
criteria_sha256 = "37cb5f679b414f6ee99c6bb62c460fd5349ff7d50cc1dab25b1e1a8e8d3c7bb9"
# MUST equal canon.lock [canon.artifacts].gates.sha256
# NB this hash is the gate table WITH the role = "canon" section (canon PR
# "feat(gates): add role=canon"). Before that section existed the canon could
# not be scored by the checker it ships, so a spine pinning the older table
# would be pinning a canon whose law was not subject to itself.
gates_sha256    = "b65ce75438c42d01bedf0325b9a97f1a575064866158b4340d7427fca911dd1b"
lockstep_since  = "2026-09-17"
# The order matters and is enforced server-side: a canon change that this repo
# cannot satisfy is a change made in the WRONG ORDER, not a rejected change.
# Land the spine's adoption first, then the canon change is a one-line bump.
order           = "spine-adopts-then-canon-releases"

[notes]
# Capabilities intentionally NOT declared (no corresponding code in tree):
#   rust           — no *.rs / Cargo.toml (the FFI/ABI layer is Zig + Idris2)
#   affinescript   — no *.affine
#   mobile         — no Tauri/Dioxus app
#   web-ui         — no browser UI
#   api-service    — not a network daemon
#   published-package — a scaffold template, not itself a registry artifact
omitted-rationale = "Declaring a capability this repo lacks would make the oracle score it against a module it does not carry — the over-scaffolding failure v2.0 fixes. See 0-canon/TEMPLATE-APPLICABILITY-POLICY.adoc."
